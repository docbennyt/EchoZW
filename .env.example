# CalenderZW environment template
#
# Production topology:
# - Vercel serves the public Vite frontend at https://calender.aido.co.zw
# - Railway serves the Node backend at https://api.calender.aido.co.zw
# - Browser API/runtime requests stay same-origin and are rewritten by Vercel.
# Never commit real secrets. Values below are names/defaults only.

# -----------------------------------------------------------------------------
# A. SHARED / PUBLIC ORIGIN
# -----------------------------------------------------------------------------
# Railway production MUST set PUBLIC_APP_URL to the public Vercel origin.
PUBLIC_APP_URL=
APP_ENV=local
ALLOW_DEMO_DATA=false

# -----------------------------------------------------------------------------
# B. VERCEL FRONTEND — browser-safe values only
# -----------------------------------------------------------------------------
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_APP_BASE_URL=http://localhost:5173
VITE_SUPPORT_EMAIL=support@aido.co.zw

# Supabase browser configuration. These values are intentionally public.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Compatibility aliases for environments that already provide them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public feature flags.
VITE_ENABLE_GOOGLE_CALENDAR_SYNC=false
VITE_ENABLE_PESEPAY_CHECKOUT=false
VITE_ENABLE_PREMIUM_FEATURES=false
VITE_ENABLE_PRIVATE_TIMETABLES=true
VITE_ENABLE_DOCUMENT_UPLOADS=false
VITE_ENABLE_CSV_IMPORT=true
VITE_ENABLE_DOCX_IMPORT=true
VITE_ENABLE_MASTER_PDF_IMPORT=false
VITE_ENABLE_AI_EXTRACTION=false
VITE_ENABLE_INSTITUTION_BRANDING=true
VITE_ENABLE_WEB_PUSH=false
VITE_ENABLE_WHATSAPP_NOTIFICATIONS=false

# Public legal presentation values. Server-side legal validation uses the
# non-VITE LEGAL_* values below and remains authoritative in production.
VITE_LEGAL_OPERATOR_NAME=aiDo
VITE_LEGAL_TRADING_NAME=CalenderZW
VITE_LEGAL_COUNTRY=Zimbabwe
VITE_LEGAL_SUPPORT_EMAIL=support@aido.co.zw
VITE_LEGAL_PRIVACY_EMAIL=privacy@aido.co.zw
VITE_LEGAL_EFFECTIVE_DATE=2026-08-05
VITE_LEGAL_LAST_UPDATED_DATE=2026-08-05
VITE_LEGAL_MINIMUM_AGE=13

# -----------------------------------------------------------------------------
# C. RAILWAY BACKEND — required production configuration
# -----------------------------------------------------------------------------
# Railway injects PORT. Do not hard-code PORT in production.
# Set NODE_ENV=production in Railway.

# Server Supabase configuration.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy privileged fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy public fallback only; prefer VITE_SUPABASE_PUBLISHABLE_KEY above.
SUPABASE_ANON_KEY=

# Legal production configuration. Human-reviewed values are required for the
# blank fields; production startup intentionally fails when they are missing.
LEGAL_OPERATOR_NAME=
LEGAL_TRADING_NAME=CalenderZW
LEGAL_OPERATOR_ADDRESS=
LEGAL_COUNTRY=Zimbabwe
LEGAL_SUPPORT_EMAIL=support@aido.co.zw
LEGAL_PRIVACY_EMAIL=privacy@aido.co.zw
LEGAL_EFFECTIVE_DATE=2026-08-05
LEGAL_LAST_UPDATED_DATE=2026-08-05
LEGAL_MINIMUM_AGE=13
LEGAL_GOVERNING_LAW=
LEGAL_DISPUTE_VENUE=

# Google Calendar direct sync. Keep the callback on the public Vercel origin;
# Vercel proxies /api/* to Railway.
ENABLE_GOOGLE_CALENDAR_SYNC=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://calender.aido.co.zw/api/calendar/google/callback
GOOGLE_CONFIG_STATUS_ADMIN_KEY=
GOOGLE_DOMAIN_OWNERSHIP_CONFIRMED=false

# Server-only calendar/security secrets.
CALENDAR_TOKEN_HASH_SECRET=
TOKEN_ENCRYPTION_KEY=
CALENDAR_STORE_PATH=/data/calenderzw-calendar-store.json

# -----------------------------------------------------------------------------
# D. OPTIONAL BACKEND INTEGRATIONS
# -----------------------------------------------------------------------------
HIT_TIMETABLE_RELAY_SECRET=

PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_WEBHOOK_SECRET=
PESEPAY_RETURN_URL=
PESEPAY_RESULT_URL=

# Optional DR-46 Web Push. Generate a VAPID keypair outside the browser; never
# expose WEB_PUSH_VAPID_PRIVATE_KEY to Vite or Vercel frontend variables.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@aido.co.zw
PUSH_NOTIFICATION_WORKER_ENABLED=true
PUSH_NOTIFICATION_WORKER_INTERVAL_MS=10000
