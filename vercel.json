{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/admin/:path*",
      "permanent": true
    },
    {
      "source": "/sync/:slug",
      "destination": "/t/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend.calender.aido.co.zw/api/:path*"
    },
    {
      "source": "/calendar/feed/:path*",
      "destination": "https://backend.calender.aido.co.zw/calendar/feed/:path*"
    },
    {
      "source": "/calendar/download/:path*",
      "destination": "https://backend.calender.aido.co.zw/calendar/download/:path*"
    },
    {
      "source": "/runtime-config.js",
      "destination": "https://backend.calender.aido.co.zw/runtime-config.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://backend.calender.aido.co.zw/sitemap.xml"
    },
    {
      "source": "/t/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(bot|crawler|spider|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|WhatsApp|Pinterest|SkypeUriPreview|Google-Structured-Data-Testing-Tool).*"
          }
        }
      ],
      "destination": "https://backend.calender.aido.co.zw/t/:slug"
    },
    {
      "source": "/t/:slug/google",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(bot|crawler|spider|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|WhatsApp|Pinterest|SkypeUriPreview|Google-Structured-Data-Testing-Tool).*"
          }
        }
      ],
      "destination": "https://backend.calender.aido.co.zw/t/:slug/google"
    },
    {
      "source": "/:path((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/calendar/feed/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/calendar/download/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/runtime-config.js",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
