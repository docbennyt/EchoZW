{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "ls tests/*.test.ts tests/*.test.tsx 2>/dev/null | sort | sed -n '30p' | xargs npx vitest run && npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/admin/:path*",
      "permanent": true
    },
    {
      "source": "/sync/:slug",
      "destination": "/t/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://calender.up.railway.app/api/:path*"
    },
    {
      "source": "/runtime-config.js",
      "destination": "https://calender.up.railway.app/runtime-config.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://calender.up.railway.app/sitemap.xml"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/runtime-config.js",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
