    "source:reconcile": "node --env-file-if-exists=.env.local dist-server/server/sourceReconciliationCli.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
