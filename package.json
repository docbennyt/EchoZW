  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "preview": "node dist-server/server/productionServer.js",
