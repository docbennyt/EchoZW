{
  "name": "calenderzw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/productionServer.js",
    "preview": "node dist-server/server/productionServer.js",
    "deploy:check": "node scripts/verify-production-readiness.mjs",
    "source:parse": "node --env-file-if-exists=.env.local dist-server/server/sourceSnapshotParseCli.js",
    "source:reconcile": "node --env-file-if-exists=.env.local dist-server/server/sourceReconciliationCli.js",
    "source:publish": "node --env-file-if-exists=.env.local dist-server/server/sourcePublicationCli.js",
    "calendar:diagnose": "node scripts/diagnose-calendar-feed.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm test && npm run build && npm run worker:check && npm run worker:automation:check",
    "worker:check": "node scripts/check-cloudflare-foundation.mjs",
    "worker:automation:check": "node scripts/check-cloudflare-automation.mjs",
    "worker:validate": "npx wrangler@4.147.0 deploy --env staging --config wrangler.jsonc --dry-run --outdir .wrangler-dry-run",
    "worker:smoke:staging": "node scripts/smoke-cloudflare-staging.mjs",
    "worker:deploy:staging": "npm run verify && npx wrangler@4.147.0 deploy --env staging --config wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "@untitledui/icons": "^0.0.22",
    "@vitejs/plugin-react": "latest",
    "exceljs": "^4.4.0",
    "lucide-react": "latest",
    "pdf-parse": "^1.1.1",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "web-push": "3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "3.6.4",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "playwright": "^1.62.1",
    "prettier": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2"
  }
}
