FROM node:24-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --silent

COPY . .

# TEMPORARY isolated formatter artifact runner for DR-151 only.
# Format exactly the files flagged by the repository's Prettier gate.
RUN npx prettier --write \
    server/docxStructuredReader.ts \
    server/staticTimetableImportRepository.ts \
    src/domain/staticTimetableDocument.ts \
    src/staticTimetableImportClient.ts \
    src/StaticTimetableImportPage.tsx \
    tests/docxStructuredReader.test.ts \
    tests/dr151ResolvedScheduleProductionRegression.test.ts \
    tests/staticTimetableDocumentImport.test.ts \
    tests/staticTimetableDocumentParser.test.ts

# Emit formatter-exact files as gzip+base64 log records, then remain healthy.
CMD ["node", "-e", "const fs=require('node:fs'),z=require('node:zlib');const files=['server/docxStructuredReader.ts','server/staticTimetableImportRepository.ts','src/domain/staticTimetableDocument.ts','src/staticTimetableImportClient.ts','src/StaticTimetableImportPage.tsx','tests/docxStructuredReader.test.ts','tests/dr151ResolvedScheduleProductionRegression.test.ts','tests/staticTimetableDocumentImport.test.ts','tests/staticTimetableDocumentParser.test.ts'];for(const f of files){console.log('DR151FMT:'+f+':'+z.gzipSync(fs.readFileSync('/app/'+f)).toString('base64'));}require('node:http').createServer((q,r)=>r.end('ok')).listen(Number(process.env.PORT||3000),'0.0.0.0');"]
