FROM node:24-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --silent

COPY . .

# TEMPORARY isolated formatter probe for Railway validation only.
# It prints the exact Prettier diff for the files reported by format:check and then exits.
RUN FILES="server/docxStructuredReader.ts server/staticTimetableImportRepository.ts src/domain/staticTimetableDocument.ts src/staticTimetableImportClient.ts src/StaticTimetableImportPage.tsx tests/docxStructuredReader.test.ts tests/dr151ResolvedScheduleProductionRegression.test.ts tests/staticTimetableDocumentImport.test.ts tests/staticTimetableDocumentParser.test.ts"; \
    for f in $FILES; do cp "$f" "/tmp/$(echo "$f" | tr '/' '_')"; done; \
    npx prettier --write $FILES; \
    for f in $FILES; do echo "===PRETTIER_DIFF:$f==="; diff -u "/tmp/$(echo "$f" | tr '/' '_')" "$f" || true; done; \
    exit 1

CMD ["node", "-e", "setInterval(() => {}, 1 << 30)"]
