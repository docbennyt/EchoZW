{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "calenderzw-edge",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/calendar/*",
      "/runtime-config.js",
      "/sitemap.xml",
      "/healthz",
      "/__release",
      "/dashboard*",
      "/sync/*"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "APP_ENV": "cloudflare-staging",
    "PUBLIC_APP_URL": "https://calender.aido.co.zw",
    "LEGACY_BACKEND_ORIGIN": "https://calender.up.railway.app"
  }
}
