{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "calenderzw-edge",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/calendar/*",
      "/assets/*",
      "/runtime-config.js",
      "/sitemap.xml",
      "/healthz",
      "/__release",
      "/dashboard*",
      "/sync/*",
    ],
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    "APP_ENV": "cloudflare-local",
    "PUBLIC_APP_URL": "https://calender.aido.co.zw",
    "LEGACY_BACKEND_ORIGIN": "https://calender.up.railway.app",
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "next.calender.aido.co.zw",
          "custom_domain": true,
        },
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "APP_ENV": "cloudflare-staging",
        "PUBLIC_APP_URL": "https://calender.aido.co.zw",
        "STAGING_ORIGIN": "https://next.calender.aido.co.zw",
        "LEGACY_BACKEND_ORIGIN": "https://calender.up.railway.app",
      },
      "r2_buckets": [
        {
          "binding": "SOURCE_BUCKET",
          "bucket_name": "calenderzw-source-staging",
        },
        {
          "binding": "CALENDAR_ARTIFACT_BUCKET",
          "bucket_name": "calenderzw-calendar-artifacts-staging",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "SOURCE_PROCESSING_QUEUE",
            "queue": "calenderzw-source-processing-staging",
          },
          {
            "binding": "PUSH_QUEUE",
            "queue": "calenderzw-push-staging",
          },
        ],
        "consumers": [
          {
            "queue": "calenderzw-source-processing-staging",
            "dead_letter_queue": "calenderzw-source-processing-dlq-staging",
          },
          {
            "queue": "calenderzw-push-staging",
            "dead_letter_queue": "calenderzw-push-dlq-staging",
          },
        ],
      },
    },
  },
}
